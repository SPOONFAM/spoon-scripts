# permanenthearts.sk
# Redeemable permanent extra hearts for plain Skript.
#
# Player commands:
#   /hearts                 - View your permanent extra hearts
#   /withdraw               - Withdraw one extra heart as an item
#   /withdraw <amount>      - Withdraw several extra hearts
#
# Operator commands:
#   /heartadmin                         - Set the exact redeemable item in a GUI
#   /hearts reset <player>               - Remove a user's extra hearts
#   /permanentheart [player] [amount]   - Give copies of that item
#
# Skript's health expressions use whole hearts, so a normal player has a
# maximum health of 10. /withdraw can remove only hearts earned here.

options:
    ph-prefix: &8[&cHearts&8] &r
    ph-item-name: &c&lPermanent Heart
    ph-admin-title: &8Permanent Heart Admin
    ph-max-extra-hearts: 8
    ph-normal-health: 10


# Returns the admin-configured item, or the default item before setup.
function permanentHeartItem(amount: number) returns item:
    if {permanenthearts.item} is set:
        set {_heart} to {permanenthearts.item}
        set item amount of {_heart} to {_amount}
        return {_heart}

    set {_heart} to {_amount} of heart of the sea named "{@ph-item-name}"
    set lore of {_heart} to "&7Right-click to permanently gain" and "&7one additional heart." and "" and "&cPermanent upgrade" and "&0PH|1"
    return {_heart}


# Opens an operator-only chest where the exact heart item can be replaced.
function openPermanentHeartAdmin(p: player):
    set {_gui} to a chest inventory with 3 rows named "{@ph-admin-title}"

    loop 27 times:
        set {_slot} to loop-number - 1
        set slot {_slot} of {_gui} to gray stained glass pane named " "

    set slot 4 of {_gui} to heart of the sea named "&c&lHEART ITEM" with lore "&7Place one exact sample in" and "&7the empty slot below." and "" and "&7Its name, lore, texture, and" and "&7other item data are preserved."
    clear slot 13 of {_gui}

    if {permanenthearts.item} is set:
        set slot 13 of {_gui} to {permanenthearts.item}

    set slot 18 of {_gui} to book named "&eHow it works" with lore "&7Normal-click an item into the" and "&7middle slot, then press save." and "" and "&7Leave it empty to restore" and "&7the default Heart of the Sea."
    set slot 22 of {_gui} to lime dye named "&a&lSAVE & CLOSE" with lore "&7Click to save the heart item."

    set {permanenthearts.admin.open::%uuid of {_p}%} to true
    open {_gui} to {_p}


# Applies the stored upgrade count without ever changing the normal 10 hearts.
function applyPermanentHearts(p: player):
    set {_id} to uuid of {_p}
    if {permanenthearts.extra::%{_id}%} is not set:
        set {permanenthearts.extra::%{_id}%} to 0

    set {_maximum} to {@ph-normal-health} + {permanenthearts.extra::%{_id}%}
    set max health of {_p} to {_maximum}
    if health of {_p} > {_maximum}:
        set health of {_p} to {_maximum}


# Operator-only item configuration GUI.
command /heartadmin:
    description: Set the redeemable permanent-heart item
    executable by: players
    trigger:
        if player is not an operator:
            send "{@ph-prefix}&cOnly server operators can use this command." to player
            stop

        openPermanentHeartAdmin(player)
        send "{@ph-prefix}&7Place one exact sample in the middle slot, then save." to player
        send "{@ph-prefix}&cUse normal clicks, not shift-click." to player


# Protects the menu while leaving only the middle sample slot editable.
on inventory click:
    if {permanenthearts.admin.open::%uuid of player%} is not true:
        stop
    if name of player's current inventory is not "{@ph-admin-title}":
        stop

    if inventory action is move to other inventory:
        cancel event
        send action bar "&cUse normal clicks to place the sample item." to player
        stop

    if inventory action is collect items to cursor:
        cancel event
        stop

    set {_rawSlot} to raw index of event-slot

    # Normal clicks in the player's lower inventory are allowed.
    if {_rawSlot} > 26:
        stop

    # The middle slot is the only editable chest slot.
    if {_rawSlot} is 13:
        stop

    cancel event

    if {_rawSlot} is 22:
        close player's inventory


# Dragging may cross protected slots, so only normal clicks are accepted.
on inventory drag:
    if {permanenthearts.admin.open::%uuid of player%} is true:
        if name of player's current inventory is "{@ph-admin-title}":
            cancel event
            send action bar "&cUse normal clicks to place the sample item." to player


# Saves one exact copy and gives back any extra items from the sample stack.
on inventory close:
    if {permanenthearts.admin.open::%uuid of player%} is not true:
        stop
    if name of event-inventory is not "{@ph-admin-title}":
        stop

    delete {permanenthearts.admin.open::%uuid of player%}

    if slot 13 of event-inventory is air:
        delete {permanenthearts.item}
        send "{@ph-prefix}&eHeart item reset to the default Heart of the Sea." to player
        stop

    set {_heart} to slot 13 of event-inventory
    set {_heartAmount} to item amount of {_heart}
    set item amount of {_heart} to 1
    set {permanenthearts.item} to {_heart}

    if {_heartAmount} > 1:
        set {_extra} to {_heartAmount} - 1
        give {_extra} of {_heart} to player

    send "{@ph-prefix}&aPermanent-heart item saved successfully." to player


# Operators can make hearts for shops, crates, or direct rewards.
command /permanentheart [<player>] [<integer>]:
    description: Give redeemable permanent-heart items
    usage: /permanentheart [player] [amount]
    executable by: players
    trigger:
        if player is not an operator:
            send "{@ph-prefix}&cOnly server operators can create permanent hearts." to player
            stop

        if arg-1 is set:
            set {_target} to arg-1
        else:
            set {_target} to player

        if arg-2 is set:
            set {_amount} to arg-2
        else:
            set {_amount} to 1

        if {_amount} < 1:
            send "{@ph-prefix}&cThe amount must be at least 1." to player
            stop
        if {_amount} > 64:
            send "{@ph-prefix}&cYou can create at most 64 hearts at once." to player
            stop

        give permanentHeartItem({_amount}) to {_target}
        send "{@ph-prefix}&aGave &f%{_amount}% Permanent Heart(s) &ato &f%{_target}%&a." to player
        if {_target} is not player:
            send "{@ph-prefix}&aYou received &f%{_amount}% Permanent Heart(s)&a." to {_target}


# Shows a player's own total, or lets an operator reset another user's extras.
command /hearts [<text>] [<offline player>]:
    description: View or administratively reset permanent extra hearts
    usage: /hearts OR /hearts reset <player>
    executable by: players
    trigger:
        if arg-1 is set:
            if arg-1 is not "reset":
                send "{@ph-prefix}&cUsage: /hearts OR /hearts reset <player>" to player
                stop

            if player is not an operator:
                send "{@ph-prefix}&cOnly server operators can reset hearts." to player
                stop

            if arg-2 is not set:
                send "{@ph-prefix}&cUsage: /hearts reset <player>" to player
                stop

            set {_target} to arg-2
            set {_targetId} to uuid of {_target}
            set {_removed} to {permanenthearts.extra::%{_targetId}%}
            if {_removed} is not set:
                set {_removed} to 0

            set {permanenthearts.extra::%{_targetId}%} to 0

            # Apply the normal 10-heart maximum immediately if they are online.
            loop all players:
                if uuid of loop-player is {_targetId}:
                    applyPermanentHearts(loop-player)
                    send "{@ph-prefix}&eYour extra hearts were reset by an operator." to loop-player

            send "{@ph-prefix}&aReset &f%{_target}%&a's extra hearts. &7Removed: &c%{_removed}%&7." to player
            stop

        set {_id} to uuid of player
        if {permanenthearts.extra::%{_id}%} is not set:
            set {permanenthearts.extra::%{_id}%} to 0
        set {_extra} to {permanenthearts.extra::%{_id}%}
        set {_total} to 10 + {_extra}
        send "{@ph-prefix}&7Extra hearts: &c%{_extra}% &8| &7Total hearts: &c%{_total}%" to player


# Converts only earned extra hearts back into redeemable items.
command /withdraw [<integer>]:
    description: Withdraw permanent extra hearts as redeemable items
    usage: /withdraw [amount]
    executable by: players
    trigger:
        if arg-1 is set:
            set {_amount} to arg-1
        else:
            set {_amount} to 1

        if {_amount} < 1:
            send "{@ph-prefix}&cThe amount must be at least 1." to player
            stop
        if {_amount} > 64:
            send "{@ph-prefix}&cYou can withdraw at most 64 hearts at once." to player
            stop

        set {_id} to uuid of player
        if {permanenthearts.extra::%{_id}%} is not set:
            set {permanenthearts.extra::%{_id}%} to 0
        set {_extra} to {permanenthearts.extra::%{_id}%}

        if {_extra} < {_amount}:
            send "{@ph-prefix}&cYou have only &f%{_extra}% &cwithdrawable extra heart(s)." to player
            send "&7Your normal 10 hearts can never be withdrawn." to player
            stop

        remove {_amount} from {permanenthearts.extra::%{_id}%}
        applyPermanentHearts(player)
        give permanentHeartItem({_amount}) to player
        send "{@ph-prefix}&aWithdrew &f%{_amount}% &aextra heart(s)." to player
        send "&7Your normal 10 hearts were not changed." to player


# Redeems one valid heart on right-click.
on right click:
    set {_heartItem} to permanentHeartItem(1)
    if player's tool is not {_heartItem}:
        stop

    cancel event
    set {_id} to uuid of player
    if {permanenthearts.extra::%{_id}%} is not set:
        set {permanenthearts.extra::%{_id}%} to 0

    if {permanenthearts.extra::%{_id}%} >= {@ph-max-extra-hearts}:
        send "{@ph-prefix}&cYou already have the maximum of &f{@ph-max-extra-hearts} &cextra hearts." to player
        stop

    # Remove exactly one item from the hand that triggered the event.
    set {_held} to player's tool
    set {_heldAmount} to amount of {_held}
    if {_heldAmount} <= 1:
        set player's tool to air
    else:
        remove 1 from {_heldAmount}
        set amount of {_held} to {_heldAmount}
        set player's tool to {_held}

    add 1 to {permanenthearts.extra::%{_id}%}
    applyPermanentHearts(player)

    set {_newHealth} to health of player + 1
    if {_newHealth} > max health of player:
        set {_newHealth} to max health of player
    set health of player to {_newHealth}

    set {_extra} to {permanenthearts.extra::%{_id}%}
    send "{@ph-prefix}&aPermanent heart redeemed! &7You now have &c%{_extra}% &7extra heart(s)." to player
    play sound "entity.player.levelup" with volume 1 and pitch 1.4 to player


# Reapply stored upgrades after other join initialization has completed.
on join:
    wait 2 ticks
    applyPermanentHearts(player)


on respawn:
    wait 2 ticks
    applyPermanentHearts(player)
    set health of player to max health of player


on load:
    loop all players:
        applyPermanentHearts(loop-player)
