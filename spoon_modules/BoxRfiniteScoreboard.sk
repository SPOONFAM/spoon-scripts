# ============================================================
# BoxRfiniteScoreboard.sk
# PURE SKRIPT / VANILLA SCOREBOARD VERSION
#
# No SkBee
# No skript-placeholders
# No EssentialsX
#
# IMPORTANT:
# Vanilla Minecraft's sidebar is shared server-wide, so a pure
# Skript version cannot show a different Rank/Kills/Deaths line
# to every player at the same time.
#
# This script:
#   - Tracks each player's kills and deaths
#   - Creates a clean shared server sidebar
#   - Shows online players + online staff
#   - Lets players check their personal stats with /stats
#
# Staff permission:
#   boxrfinite.staff
# ============================================================


# ------------------------------------------------------------
# SETUP
# ------------------------------------------------------------

on load:
    execute console command "scoreboard objectives remove boxrf"
    execute console command "scoreboard objectives add boxrf dummy {\"text\":\"ʙᴏxʀғɪɴɪᴛᴇ\",\"color\":\"gold\",\"bold\":true}"
    execute console command "scoreboard objectives setdisplay sidebar boxrf"

    # Static lines
    execute console command "scoreboard players set \"§8§m--------------------\" boxrf 10"
    execute console command "scoreboard players set \"§fѕᴇʀᴠᴇʀ\" boxrf 9"
    execute console command "scoreboard players set \"§7 \" boxrf 6"
    execute console command "scoreboard players set \"§bdiscord.gg/8UJ8uvZ2jQ\" boxrf 2"
    execute console command "scoreboard players set \"§8§m-------------------\" boxrf 1"


# ------------------------------------------------------------
# PLAYER DATA
# ------------------------------------------------------------

on join:
    if {boxstats::%uuid of player%::kills} is not set:
        set {boxstats::%uuid of player%::kills} to 0

    if {boxstats::%uuid of player%::deaths} is not set:
        set {boxstats::%uuid of player%::deaths} to 0


on death of player:
    add 1 to {boxstats::%uuid of player%::deaths}

    # Older Skript versions use "killer" more reliably than "attacker".
    if killer is a player:
        add 1 to {boxstats::%uuid of killer%::kills}


# ------------------------------------------------------------
# SHARED SERVER SCOREBOARD
# ------------------------------------------------------------

every 2 seconds:
    set {_online} to size of all players
    set {_staff} to 0

    loop all players:
        if loop-player has permission "boxrfinite.staff":
            add 1 to {_staff}

    # Remove previous changing lines.
    loop {boxboard::dynamic::*}:
        execute console command "scoreboard players reset \"%loop-value%\" boxrf"
    delete {boxboard::dynamic::*}

    set {_playersLine} to "§7Players: §e%{_online}%"
    set {_staffLine} to "§7Staff: §b%{_staff}%"

    add {_playersLine} to {boxboard::dynamic::*}
    add {_staffLine} to {boxboard::dynamic::*}

    execute console command "scoreboard players set \"%{_playersLine}%\" boxrf 8"
    execute console command "scoreboard players set \"%{_staffLine}%\" boxrf 7"


# ------------------------------------------------------------
# PERSONAL STATS
# ------------------------------------------------------------

command /stats:
    trigger:
        set {_kills} to {boxstats::%uuid of player%::kills}
        set {_deaths} to {boxstats::%uuid of player%::deaths}

        if {_kills} is not set:
            set {_kills} to 0

        if {_deaths} is not set:
            set {_deaths} to 0

        # Standalone rank detection using permissions.
        # Change these permissions/rank names to match your server.
        set {_rank} to "&7Player"

        if player has permission "boxrfinite.rank.vip":
            set {_rank} to "&aVIP"

        if player has permission "boxrfinite.rank.mod":
            set {_rank} to "&2MOD"

        if player has permission "boxrfinite.rank.admin":
            set {_rank} to "&cADMIN"

        if player has permission "boxrfinite.rank.owner":
            set {_rank} to "&6&lOWNER"

        send "&8&m-------------------------"
        send "&6&lʙᴏxʀғɪɴɪᴛᴇ"
        send ""
        send "&fᴘʀᴏғɪʟᴇ"
        send "&7Rank: %{_rank}%"
        send "&7Kills: &a%{_kills}%"
        send "&7Deaths: &c%{_deaths}%"
        send ""
        send "&8&m-------------------------"


# ------------------------------------------------------------
# ADMIN RESET COMMANDS
# ------------------------------------------------------------

command /resetkills <offlineplayer>:
    trigger:
        if player is not op:
            send "&cYou must be OP."
            stop

        set {boxstats::%uuid of arg-1%::kills} to 0
        send "&aReset &f%arg-1%&a's kills."


command /resetdeaths <offlineplayer>:
    trigger:
        if player is not op:
            send "&cYou must be OP."
            stop

        set {boxstats::%uuid of arg-1%::deaths} to 0
        send "&aReset &f%arg-1%&a's deaths."
