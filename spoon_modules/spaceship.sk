        loop {_part::*}:
            add loop-value to {_notes::*}
        delete {_part::*}

        loop {_notes::*}:
            if {spaceship.playing::%uuid of player%} is not true:
                delete {spaceship.playing::%uuid of player%}
                send "&7Spaceship stopped."
                stop

            set {_pitch} to loop-value parsed as number

            if {_pitch} > 0:
                play sound "block.note_block.harp" with volume 1 and pitch {_pitch} to player

            wait 5 ticks

        delete {spaceship.playing::%uuid of player%}
        send "&aSpaceship finished!"

command /stopspaceship:
    trigger:
        if {spaceship.playing::%uuid of player%} is true:
            set {spaceship.playing::%uuid of player%} to false
            send "&cStopping Spaceship..."
        else:
            send "&7You do not have Spaceship playing."

on right click:
    if player's tool is music disc 13:
        if name of player's tool is "&b&lSpaceship":
            cancel event

            if {spaceship.playing::%uuid of player%} is true:
                send "&cSpaceship is already playing. Use &f/stopspaceship&c first."
                stop

            execute player command "spaceship"

on quit:
    delete {spaceship.playing::%uuid of player%}
