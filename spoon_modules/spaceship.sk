# ============================================================
# BoxRfinite - Spaceship Note-Block Disc
# Generated from the uploaded MP4 as a Minecraft-style remake.
#
# No resource pack required.
# Uses only vanilla note-block sounds.
#
# Commands:
#   /spaceshipdisc  -> gives the custom disc
#   /spaceship      -> plays the song for yourself
#   /stopspaceship  -> stops your playback
# ============================================================

command /spaceshipdisc:
    permission: boxrfinite.spaceshipdisc
    permission message: &cYou do not have permission.
    trigger:
        give 1 music disc 13 named "&b&lSpaceship" with lore "&7Right-click to play the BoxRfinite remake." to player
        send "&aYou received the &b&lSpaceship &adisc!"

command /spaceship:
    trigger:
        if {spaceship.playing::%uuid of player%} is true:
            send "&cSpaceship is already playing. Use &f/stopspaceship&c first."
            stop

        set {spaceship.playing::%uuid of player%} to true
        send "&bNow playing: &fSpaceship &7(Minecraft note-block remake)"

        delete {_notes::*}
        set {_part::*} to split "0.841,0.841,0.841,0.841,0.841,0.707,1.335,1.414,1.414,1.260,1.260,1.260,1.414,1.260,1.260,1.414,0.841,1.260,1.260,1.260,1.414,0.707,1.335,1.414,1.414,1.682,1.260,1.260,1.414,1.335,1.260,0.630,1.414,1.335,0.841,0.841,0.841,1.888,1.059,1.335,0.749,1.122,1.122,0.749,0.530,0.561,0.749,0.944,1.782,1.888,1.682,0.841,1.059,0.841,1.122,1.260,1.335,1.000,0.841,1.000,0.749,0.530,1.888,1.888,1.122,0.749,0.841,0.841,0.841,0.667,1.260,1.414,1.414,1.335,1.260,1.260,1.189,1.335,1.260,1.260,1.189,1.335,1.260,1.260,1.414,0.841,1.189,1.414,1.414,2.000,1.260,1.260,1.414,1.335,1.260,1.260,1.414,1.414,1.260,0.841,0.841,0.841,1.888,1.059,1.335,0.749,1.260,0.944,0.944,0.595,0.749,0.749,0.749,0.944,0.707,0.841,1.888,0.841,0.841,0.707" at ","
