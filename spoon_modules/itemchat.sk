# itemchat.sk
# Type [item] in chat to show the item held in the main hand.
# Hovering the bracketed item name displays Minecraft's item tooltip.
#
# Install:
#   1. Put this file in plugins/Skript/scripts/spoon_modules/
#   2. Run: /sk reload spoon_modules
#
# This module uses plain Skript. It does not cancel chat, so EssentialsChat,
# prefixes, suffixes, and the server's normal chat format can still be used.

options:
    itemchat-empty: &8[&7Empty Hand&8]


on chat:
    if message does not contain "[item]":
        stop

    # Work with a plain copy so players cannot inject MiniMessage click tags.
    set {_chat} to unformatted "%message%"
    replace all "<" with "(" in {_chat}
    replace all ">" with ")" in {_chat}

    set {_held} to player's tool
    if {_held} is air:
        replace all "[item]" with "{@itemchat-empty}" in {_chat}
        set message to colored {_chat}
        stop

    # raw name returns the exact vanilla key, such as minecraft:diamond_sword.
    set {_itemKey} to raw name of {_held}
    set {_amount} to item amount of {_held}

    if name of {_held} is set:
        set {_itemName} to unformatted "%name of {_held}%"
    else:
        set {_itemName} to "%type of {_held}%" in strict proper case

    # Item names may come from anvils, so keep them from becoming chat tags.
    replace all "<" with "(" in {_itemName}
    replace all ">" with ")" in {_itemName}

    if {_amount} > 1:
        set {_amountText} to " <gray>x%{_amount}%</gray>"
    else:
        set {_amountText} to ""

    set {_itemTag} to "<hover:show_item:'%{_itemKey}%':%{_amount}%><aqua>[<white>%{_itemName}%</white>%{_amountText}%<aqua>]</aqua></hover>"
    replace all "[item]" with {_itemTag} in {_chat}

    # Only this script's hover tag is parsed as an interactive component.
    set message to formatted {_chat}
