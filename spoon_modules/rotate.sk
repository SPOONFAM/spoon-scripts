# ==========================================================
# BoxRfinite Rotating Boss Bar
# No Skript bossbar addon required
# ==========================================================

on load:
    # Remove old bar if it already exists
    execute console command "bossbar remove boxrfinite:info"

    wait 2 ticks

    # Create boss bar
    execute console command "bossbar add boxrfinite:info {""text"":""BoxRfinite"",""color"":""gold"",""bold"":true}"
    execute console command "bossbar set boxrfinite:info color yellow"
    execute console command "bossbar set boxrfinite:info style progress"
    execute console command "bossbar set boxrfinite:info max 100"
    execute console command "bossbar set boxrfinite:info value 100"
    execute console command "bossbar set boxrfinite:info visible true"
    execute console command "bossbar set boxrfinite:info players @a"

    set {boxrfinite.rotation} to 1


every 5 seconds:
    add 1 to {boxrfinite.rotation}

    if {boxrfinite.rotation} > 3:
        set {boxrfinite.rotation} to 1

    if {boxrfinite.rotation} = 1:
        execute console command "bossbar set boxrfinite:info name {""text"":""BoxRfinite"",""color"":""gold"",""bold"":true}"

    else if {boxrfinite.rotation} = 2:
        execute console command "bossbar set boxrfinite:info name {""text"":""Join our Discord: discord.gg/8UJ8uvZ2jQ"",""color"":""aqua""}"

    else if {boxrfinite.rotation} = 3:
        execute console command "bossbar set boxrfinite:info name {""text"":""Welcome to BoxRfinite!"",""color"":""yellow""}"

    execute console command "bossbar set boxrfinite:info players @a"


on join:
    wait 1 second
    execute console command "bossbar set boxrfinite:info players @a"


on quit:
    wait 1 tick
    execute console command "bossbar set boxrfinite:info players @a"
