# compressor.sk
# GUI-configured custom currency compressor with a permanent voucher unlock.
#
# Install:
#   1. Put this file in plugins/Skript/scripts/
#   2. Run: /sk reload compressor
#   3. As an operator, run: /compressadmin
#   4. Place one exact sample item in each labeled GUI slot and close it.
#
# The GUI saves the complete item: material, name, gradient, lore, model data,
# enchantments, and other metadata. LuckPerms is used for permission redemption.

options:
    prefix: &8[&6Compressor&8] &r
    admin-title: &8Compressor Admin
    use-permission: compressor.use
    requested-use-permission: compressor:use
    compress-interval: 1 second


# The saved unlock works immediately. Both permission spellings are accepted.
function hasCompressor(p: player) returns boolean:
    if {compressor.unlocked::%uuid of {_p}%} is true:
        return true
    if {_p} has permission "{@use-permission}":
        return true
    if {_p} has permission "{@requested-use-permission}":
        return true
    return false


function currencyItemsAreConfigured() returns boolean:
    if {compressor.item::coin} is not set:
        return false
    if {compressor.item::compressed} is not set:
        return false
    if {compressor.item::super} is not set:
        return false
    return true


# Opens the operator configuration chest.
function openCompressorAdmin(p: player):
    set {_gui} to a chest inventory with 3 rows named "{@admin-title}"

    loop 27 times:
        set {_slot} to loop-number - 1
        set slot {_slot} of {_gui} to gray stained glass pane named " "

    # Labels are directly above their editable input slots.
    set slot 1 of {_gui} to gold nugget named "&6Coin" with lore "&7Place the exact Coin item" and "&7in the empty slot below."
    set slot 3 of {_gui} to gold block named "&eCompressed Coin" with lore "&7Place the exact Compressed Coin" and "&7in the empty slot below."
    set slot 5 of {_gui} to netherite ingot named "&aSuper Compressed Coin" with lore "&7Place the exact Super Coin" and "&7in the empty slot below."
    set slot 7 of {_gui} to nether star named "&dUnlock Voucher" with lore "&7Place the exact redeemable voucher" and "&7in the empty slot below."

    clear slot 10 of {_gui}
    clear slot 12 of {_gui}
    clear slot 14 of {_gui}
    clear slot 16 of {_gui}

    if {compressor.item::coin} is set:
        set slot 10 of {_gui} to {compressor.item::coin}
    if {compressor.item::compressed} is set:
        set slot 12 of {_gui} to {compressor.item::compressed}
    if {compressor.item::super} is set:
        set slot 14 of {_gui} to {compressor.item::super}
    if {compressor.item::voucher} is set:
        set slot 16 of {_gui} to {compressor.item::voucher}

    set slot 22 of {_gui} to lime dye named "&a&lSAVE & CLOSE" with lore "&7Click to save all four item types."

    set {compressor.admin.open::%uuid of {_p}%} to true
    open {_gui} to {_p}


# Converts complete recipe amounts and leaves every remainder untouched.
function compressInventory(p: player):
    if currencyItemsAreConfigured() is false:
        return

    set {_coin} to {compressor.item::coin}
    set {_compressedCoin} to {compressor.item::compressed}
    set {_superCompressedCoin} to {compressor.item::super}

    # 16 Diamonds -> 32 Coins
    set {_amount} to amount of plain diamond in {_p}'s inventory
    if {_amount} >= 16:
        set {_crafts} to floor({_amount} / 16)
        set {_used} to {_crafts} * 16
        set {_reward} to {_crafts} * 32
        remove {_used} of plain diamond from {_p}'s inventory
        give {_reward} of {_coin} to {_p}

    # 24 Gold Ingots -> 32 Coins
    set {_amount} to amount of plain gold ingot in {_p}'s inventory
    if {_amount} >= 24:
        set {_crafts} to floor({_amount} / 24)
        set {_used} to {_crafts} * 24
        set {_reward} to {_crafts} * 32
        remove {_used} of plain gold ingot from {_p}'s inventory
        give {_reward} of {_coin} to {_p}

    # 24 Emeralds -> 32 Coins
    set {_amount} to amount of plain emerald in {_p}'s inventory
    if {_amount} >= 24:
        set {_crafts} to floor({_amount} / 24)
        set {_used} to {_crafts} * 24
        set {_reward} to {_crafts} * 32
        remove {_used} of plain emerald from {_p}'s inventory
        give {_reward} of {_coin} to {_p}

    # 64 Lapis Lazuli -> 32 Coins
    set {_amount} to amount of plain lapis lazuli in {_p}'s inventory
    if {_amount} >= 64:
        set {_crafts} to floor({_amount} / 64)
        set {_used} to {_crafts} * 64
        set {_reward} to {_crafts} * 32
        remove {_used} of plain lapis lazuli from {_p}'s inventory
        give {_reward} of {_coin} to {_p}

    # 64 Ancient Debris -> 48 Compressed Coins
    set {_amount} to amount of plain ancient debris in {_p}'s inventory
    if {_amount} >= 64:
        set {_crafts} to floor({_amount} / 64)
        set {_used} to {_crafts} * 64
        set {_reward} to {_crafts} * 48
        remove {_used} of plain ancient debris from {_p}'s inventory
        give {_reward} of {_compressedCoin} to {_p}

    # 64 configured Coins -> 1 configured Compressed Coin
    set {_amount} to amount of {_coin} in {_p}'s inventory
    if {_amount} >= 64:
        set {_crafts} to floor({_amount} / 64)
        set {_used} to {_crafts} * 64
        remove {_used} of {_coin} from {_p}'s inventory
        give {_crafts} of {_compressedCoin} to {_p}

    # 32 configured Compressed Coins -> 1 configured Super Coin
    set {_amount} to amount of {_compressedCoin} in {_p}'s inventory
    if {_amount} >= 32:
        set {_crafts} to floor({_amount} / 32)
        set {_used} to {_crafts} * 32
        remove {_used} of {_compressedCoin} from {_p}'s inventory
        give {_crafts} of {_superCompressedCoin} to {_p}


# Operator-only chest configuration command.
command /compressadmin:
    description: Configure the compressor currency and voucher items
    executable by: players
    trigger:
        if player is not an operator:
            send "{@prefix}&cOnly server operators can use this command." to player
            stop

        openCompressorAdmin(player)
        send "{@prefix}&7Place one exact sample into each labeled slot, then save." to player
        send "{@prefix}&cDo not shift-click; use normal clicks to move the samples." to player


# Protects the GUI decorations while leaving the four setting slots editable.
on inventory click:
    if {compressor.admin.open::%uuid of player%} is not true:
        stop
    if name of player's current inventory is not "{@admin-title}":
        stop

    # Shift-clicking can choose the wrong input slot, so block it.
    if inventory action is move to other inventory:
        cancel event
        send action bar "&cUse normal clicks to place configuration items." to player
        stop

    # Double-click collection could pull configured items out unexpectedly.
    if inventory action is collect items to cursor:
        cancel event
        stop

    set {_rawSlot} to raw index of event-slot

    # Normal clicks in the player's lower inventory are allowed.
    if {_rawSlot} > 26:
        stop

    # Only these four chest slots accept configuration items.
    if {_rawSlot} is 10:
        stop
    if {_rawSlot} is 12:
        stop
    if {_rawSlot} is 14:
        stop
    if {_rawSlot} is 16:
        stop

    cancel event

    if {_rawSlot} is 22:
        close player's inventory


# Dragging is blocked because it can cross protected and editable slots at once.
on inventory drag:
    if {compressor.admin.open::%uuid of player%} is true:
        if name of player's current inventory is "{@admin-title}":
            cancel event
            send action bar "&cUse normal clicks to place configuration items." to player


# Closing the chest saves exact one-item templates from the four input slots.
on inventory close:
    if {compressor.admin.open::%uuid of player%} is not true:
        stop
    if name of event-inventory is not "{@admin-title}":
        stop

    delete {compressor.admin.open::%uuid of player%}

    if slot 10 of event-inventory is air:
        delete {compressor.item::coin}
    else:
        set {_coin} to slot 10 of event-inventory
        set {_coinAmount} to item amount of {_coin}
        set item amount of {_coin} to 1
        set {compressor.item::coin} to {_coin}
        if {_coinAmount} > 1:
            set {_extra} to {_coinAmount} - 1
            give {_extra} of {_coin} to player

    if slot 12 of event-inventory is air:
        delete {compressor.item::compressed}
    else:
        set {_compressed} to slot 12 of event-inventory
        set {_compressedAmount} to item amount of {_compressed}
        set item amount of {_compressed} to 1
        set {compressor.item::compressed} to {_compressed}
        if {_compressedAmount} > 1:
            set {_extra} to {_compressedAmount} - 1
            give {_extra} of {_compressed} to player

    if slot 14 of event-inventory is air:
        delete {compressor.item::super}
    else:
        set {_super} to slot 14 of event-inventory
        set {_superAmount} to item amount of {_super}
        set item amount of {_super} to 1
        set {compressor.item::super} to {_super}
        if {_superAmount} > 1:
            set {_extra} to {_superAmount} - 1
            give {_extra} of {_super} to player

    if slot 16 of event-inventory is air:
        delete {compressor.item::voucher}
    else:
        set {_voucher} to slot 16 of event-inventory
        set {_voucherAmount} to item amount of {_voucher}
        set item amount of {_voucher} to 1
        set {compressor.item::voucher} to {_voucher}
        if {_voucherAmount} > 1:
            set {_extra} to {_voucherAmount} - 1
            give {_extra} of {_voucher} to player

    if currencyItemsAreConfigured() is true:
        send "{@prefix}&aCurrency items saved successfully." to player
    else:
        send "{@prefix}&cCurrency setup is incomplete. Fill the first three slots." to player

    if {compressor.item::voucher} is set:
        send "{@prefix}&aVoucher item saved successfully." to player
    else:
        send "{@prefix}&eVoucher is not configured; /compressvoucher is unavailable." to player


# Right-clicking the exact configured voucher permanently unlocks the feature.
on right click:
    if {compressor.item::voucher} is not set:
        stop

    set {_voucher} to {compressor.item::voucher}
    if player's tool is not {_voucher}:
        stop

    cancel event

    if hasCompressor(player) is true:
        send "{@prefix}&eYou have already unlocked the compressor." to player
        stop

    remove 1 of {_voucher} from player's inventory
    set {compressor.unlocked::%uuid of player%} to true
    execute console command "lp user %uuid of player% permission set {@use-permission} true"
    execute console command "lp user %uuid of player% permission set {@requested-use-permission} true"
    set {compressor.enabled::%uuid of player%} to false
    send "{@prefix}&aCompressor access permanently unlocked!" to player
    send "{@prefix}&7Use &e/compress on &7when you want to enable it." to player
    play sound "entity.player.levelup" with volume 1 and pitch 1 to player


command /compress [<text>]:
    description: Enable, disable, or check your automatic compressor
    usage: /compress <on|off|status>
    executable by: players
    trigger:
        if hasCompressor(player) is false:
            send "{@prefix}&cRedeem a Compressor Voucher before using this command." to player
            stop

        if currencyItemsAreConfigured() is false:
            send "{@prefix}&cThe server owner has not finished /compressadmin setup." to player
            stop

        if arg-1 is not set:
            if {compressor.enabled::%uuid of player%} is true:
                send "{@prefix}&7Your compressor is currently &aON&7." to player
            else:
                send "{@prefix}&7Your compressor is currently &cOFF&7." to player
            send "{@prefix}&7Use &e/compress on &7or &e/compress off&7." to player
            stop

        if arg-1 is "on":
            if {compressor.enabled::%uuid of player%} is true:
                send "{@prefix}&eYour compressor is already enabled." to player
                stop
            set {compressor.enabled::%uuid of player%} to true
            compressInventory(player)
            send "{@prefix}&aAutomatic compression enabled." to player
            stop

        if arg-1 is "off":
            if {compressor.enabled::%uuid of player%} is not true:
                send "{@prefix}&eYour compressor is already disabled." to player
                stop
            set {compressor.enabled::%uuid of player%} to false
            send "{@prefix}&cAutomatic compression disabled." to player
            stop

        if arg-1 is "status":
            if {compressor.enabled::%uuid of player%} is true:
                send "{@prefix}&7Your compressor is currently &aON&7." to player
            else:
                send "{@prefix}&7Your compressor is currently &cOFF&7." to player
            stop

        send "{@prefix}&cUsage: /compress <on|off|status>" to player


# Gives the operator an exact copy of the voucher configured in the GUI.
command /compressvoucher:
    description: Receive a configured redeemable Compressor Voucher
    executable by: players
    trigger:
        if player is not an operator:
            send "{@prefix}&cOnly server operators can use this command." to player
            stop

        if {compressor.item::voucher} is not set:
            send "{@prefix}&cSet the voucher item with /compressadmin first." to player
            stop

        give {compressor.item::voucher} to player
        send "{@prefix}&aYou received the configured Compressor Voucher." to player


on load:
    delete {compressor.admin.open::*}


every {@compress-interval}:
    if currencyItemsAreConfigured() is true:
        loop all players:
            if hasCompressor(loop-player) is true:
                if {compressor.enabled::%uuid of loop-player%} is true:
                    compressInventory(loop-player)
